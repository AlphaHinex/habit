# lark-ws 环境变量示例
#
# 使用方式：
#   cp .env.example .env
#   chmod 600 .env
#   编辑 .env 填入真实值
#
# .env 已被 .gitignore 忽略，不会进入版本库。也可以不用 .env，
# 直接在启动前 export 同名变量。

# 飞书自建应用（开发者后台 -> 凭证与基础信息）
APP_ID=cli_xxxxxxxxxxxxxxxx
APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token，需要目标仓库 contents 的读写权限
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- 以下为可选调优参数，不填使用默认值 ----
# 并发 worker 数；>1 时下载并行，GitHub 写仍串行（默认 1，保证顺序）
# LARK_WS_WORKERS=1
# 事件 / 工作队列长度（默认 1024）
# LARK_WS_QUEUE_SIZE=1024
# 断线补偿扫描间隔与首次延迟（默认 5m / 30s，设为 0 可关闭扫描）
# LARK_WS_CATCHUP_INTERVAL=5m
# LARK_WS_CATCHUP_INITIAL_DELAY=30s
# 断线后最多回补多长时间（默认 24h）
# LARK_WS_MAX_BACKFILL=24h
# GitHub 写/读请求最小间隔（默认 1s / 100ms）
# GITHUB_WRITE_INTERVAL=1s
# GITHUB_READ_INTERVAL=100ms
# GitHub 单请求最大尝试次数、HTTP 超时（默认 6 / 60s）
# GITHUB_MAX_ATTEMPTS=6
# GITHUB_HTTP_TIMEOUT=60s
# 飞书 API 单请求超时（默认 30s）
# LARK_HTTP_TIMEOUT=30s
